    "moment": "^2.30.1",
    "winston": "^3.19.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0",
    "utf-8-validate": "^6.0.6"
  },
  "repository": "github:mindflayer-vtt/mindflayer-server",
  "engines": {
